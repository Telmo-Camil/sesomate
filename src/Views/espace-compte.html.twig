{% extends 'base.html.twig' %}

{% block content %}
    <main class="main-centered dashboard-container">
        {% if user.admin == 1 %}
            <div class="titre-container dashboard-header">
                <h1>
                    Mon Espace Compte
                </h1>
                <h2>
                    Bienvenue,
                    {{ user.pseudo }}
                </h2>
            </div>

            <h3 class="dashboard-section-title">
                Mon Profil
            </h3>
            <div class="dashboard-grid">

                <a href="/profil/infos" class="dashboard-card">
                    <div class="card-icon">
                        👤
                    </div>
                    <h4>
                        Infos Profil
                    </h4>
                    <p>
                        Gérer mes informations personnelles et mon mot de passe.
                    </p>
                </a>

                <a href="/wishlist" class="dashboard-card">
                    <div class="card-icon">
                        ❤️
                    </div>
                    <h4>
                        Ma Wishlist
                    </h4>
                    <p>
                        Retrouver les offres que j'ai sauvegardées.
                    </p>
                </a>

            </div>
        {% endif %}
        {% if user.admin == 3 %}
            <div class="titre-container dashboard-header">
                <h1>
                    Mon Espace Compte
                </h1>
                <h2>
                    Bienvenue,
                    {{ user.pseudo }}
                </h2>
            </div>

            <h3 class="dashboard-section-title">
                Mon Profil
            </h3>
            <div class="dashboard-grid">

                <a href="/profil/infos" class="dashboard-card">
                    <div class="card-icon">
                        👤
                    </div>
                    <h4>
                        Infos Profil
                    </h4>
                    <p>
                        Gérer mes informations personnelles et mon mot de passe.
                    </p>
                </a>

                <a href="/wishlist" class="dashboard-card">
                    <div class="card-icon">
                        ❤️
                    </div>
                    <h4>
                        Ma Wishlist
                    </h4>
                    <p>
                        Retrouver les offres que j'ai sauvegardées.
                    </p>
                </a>

            </div>
            <h3 class="dashboard-section-title admin-title">
                Espace Administration
            </h3>
            <div class="dashboard-grid admin-grid">

                <a href="/admin/offer" class="dashboard-card admin-card">
                    <div class="card-icon">
                        💼
                    </div>
                    <h4>
                        Gestion Offres
                    </h4>
                    <p>
                        Créer, modifier ou supprimer des offres d'emploi.
                    </p>
                </a>

                <a href="/admin/entreprises" class="dashboard-card admin-card">
                    <div class="card-icon">
                        🏢
                    </div>
                    <h4>
                        Gestion Entreprises
                    </h4>
                    <p>
                        Administrer les entreprises partenaires.
                    </p>
                </a>

                <a href="/admin/utilisateurs" class="dashboard-card admin-card">
                    <div class="card-icon">
                        👥
                    </div>
                    <h4>
                        Gestion Utilisateurs
                    </h4>
                    <p>
                        Gérer les comptes et les droits d'accès.
                    </p>
                </a>

            </div>
        {% endif %}
        {% if user.admin == 2 %}
            <div class="titre-container dashboard-header">
                <h1>
                    Mon Espace Compte
                </h1>
                <h2>
                    Bienvenue,
                    {{ user.pseudo }}
                </h2>
            </div>

            <h3 class="dashboard-section-title">
                Mon Profil
            </h3>
            <div class="dashboard-grid">

                <a href="/profil/infos" class="dashboard-card">
